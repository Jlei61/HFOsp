  "onset_cycle_fold_homoclinic": "\u65b0\u589e\u7684\u5468\u671f\u6298\u70b9\u548c\u540c\u5bbf\u578b\u7ec8\u6b62\u6784\u6210\u4e00\u4e2a\u7a84\u7684\u7a33\u5b9a\u4f4e\u7387/\u5468\u671fburst\u5171\u5b58\u533a\u3002\u5b9e/\u865a\u7ebf\u5468\u671f\u6bb5\u7531\u6298\u70b9\u4e24\u4fa7\u8fd4\u56de\u4e58\u5b50\u6838\u67e5\u652f\u6301\uff1bHC\u6765\u81ea\u6709\u9650\u957f\u5468\u671f\u8f68\u9053\u5bf9\u540c\u4e00\u978d\u70b9\u7684\u903c\u8fd1\u53ca\u53c2\u6570\u6307\u6570\u6536\u655b\uff0c\u800c\u975e\u5df2\u7ecf\u6c42\u5f97\u7cbe\u786e\u65e0\u9650\u65f6\u957f\u540c\u5bbf\u8fb9\u503c\u89e3\u3002",
