{
  "schema_version": 1,
  "experiment_id": "fcxr_lc6a_gain_state_forks",
  "scientific_role": "paired exact-state responsiveness assay after the fixed five-arm phenotype map",
  "selection": {
    "source": "phenotype_map.json::fork_candidates",
    "maximum_conditions": 2,
    "checkpoint_names": ["onset_plus_2s", "onset_plus_6s"],
